<?xml version="1.0"?>
<robot xmlns:xacro="http://ros.org/wiki/xacro">

  
  <xacro:include filename="$(find roboto)/robot_description/sim_bot/omni_wheel/omni_wheel.gazebo.xacro"/>
  
  <xacro:macro name="wheel_v0" params="prefix parent *joint_origin *joint_axis">
	
  <joint name="wheel_${prefix}_joint" type="continuous">
	  <xacro:insert_block name="joint_origin"/>
	  <parent link="${parent}"/>

	  <child link="wheel_${prefix}_link"/>
          <limit effort="100" velocity="100"/>
          <dynamics damping="0.0" friction="0.1"/>
          
          
	  <xacro:insert_block name="joint_axis"/>
	</joint>

	<link name="wheel_${prefix}_link">
	 
   
	  <collision>
		<geometry>
		  <mesh filename="package://roboto/robot_description/meshes/STL/omni_wheel/omni_wheel.stl"/>
		</geometry>
	  </collision>
	  <inertial>
		<origin xyz="0.0 -0.011 -0.0"/>
		<mass value="0.25"/>
		<inertia ixx="0.00031" ixy="0" ixz="0" iyy="0.0005" iyz="0" izz="0.00031"/>
	  </inertial>
          <surface>
            <friction>
              <ode>
                <mu1>1.2</mu1>
                <mu2>1.2</mu2>
                
              </ode>
            </friction>
            
          </surface>
	</link>
  </xacro:macro>
  
</robot>
